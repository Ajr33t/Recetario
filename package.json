{
  "name": "sazonlab",
  "version": "1.0.0",
  "private": true,
  "description": "SazónLab — Recetario Inteligente (monorepo: apps/web, apps/api, apps/desktop, apps/landing)",
  "license": "MIT",
  "workspaces": [
    "apps/web",
    "apps/api",
    "apps/desktop",
    "apps/landing"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:app": "npm run dev --workspace apps/web",
    "dev:server": "npm run dev --workspace apps/api",
    "dev:landing": "npm run dev --workspace apps/landing",
    "dev:desktop": "npm run start --workspace apps/desktop",
    "build:app": "npm run build --workspace apps/web",
    "build:landing": "npm run build --workspace apps/landing",
    "sincronizar:desktop": "node scripts/sincronizar-desktop.cjs",
    "copiar:exe": "node scripts/copiar-exe.cjs",
    "build:exe": "npm run build:app && npm run sincronizar:desktop && npm run dist --workspace apps/desktop && npm run copiar:exe",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test apps/web/src apps/api/src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verificar:contraste": "node scripts/verificar-contraste.mjs",
    "verificar:temas": "electron scripts/verificar-temas.cjs",
    "verificar:auth": "node scripts/verificar-auth.mjs",
    "verificar:busqueda": "node scripts/verificar-busqueda.mjs",
    "verificar:recetas": "node scripts/verificar-recetas.mjs",
    "verificar:ui-f5": "electron scripts/verificar-ui-f5.cjs",
    "verificar:ui-f6": "electron scripts/verificar-ui-f6.cjs",
    "verificar:landing": "electron scripts/verificar-landing.cjs",
    "verificar:cuenta": "electron scripts/verificar-cuenta.cjs",
    "verificar:desktop": "node scripts/verificar-desktop.mjs",
    "verificar:a11y": "electron scripts/verificar-a11y.cjs",
    "capturas": "electron scripts/capturas.cjs",
    "logo": "electron scripts/generar-logo.cjs",
    "verificar:pedidos": "electron scripts/verificar-pedidos.cjs",
    "verificar:movil": "electron scripts/verificar-movil.cjs",
    "manual:pdf": "electron scripts/generar-manual-pdf.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "pg-mem": "^3.0.14",
    "prettier": "^3.9.10"
  },
  "dependencies": {
    "marked": "^18.2.0"
  }
}
