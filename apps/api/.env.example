# Correo de recuperación de contraseña (Fase 10)
# ------------------------------------------------------------------
# Opción A — SMTP (recomendado; funciona con Gmail, Outlook y SMTP
# corporativo). Usa una "contraseña de aplicación", no tu contraseña real.
#
#   Gmail:    SMTP_HOST=smtp.gmail.com   SMTP_PORT=465  SMTP_SECURE=true
#   Outlook:  SMTP_HOST=smtp.office365.com SMTP_PORT=587 SMTP_SECURE=false
#   Otro:     el host y el puerto que te indique tu proveedor
#
# SMTP_USER=tu.correo@gmail.com
# SMTP_PASS=tu-contraseña-de-aplicación
# SMTP_SECURE=false
# MAIL_FROM=SazónLab <tu.correo@gmail.com>
#
# Opción B — Resend (API de correo, 3000 correos/mes gratis):
#   RESEND_API_KEY=re_xxxxxxxxxxxx
#   MAIL_FROM=SazónLab <onboarding@resend.dev>
#
# Sin ninguna de las dos, SazónLab funciona en MODO DEMO: el código de
# recuperación se muestra en pantalla y en la consola del servidor.
#
# Puedes generar este archivo con:  npm run configurar:correo

# Enlace que se incluye en el correo (para el botón «Restablecer contraseña»)
APP_URL=http://localhost:5173

# Puerto del servidor API
PORT=3001

# Secreto para firmar JWT (¡cambiar en producción!)
JWT_SECRET=cambiar-en-produccion

# Opcional: API keys de IA (si no existen, se usa TheMealDB como fallback)
OPENAI_API_KEY=
GEMINI_API_KEY=

# IA local con Ollama (http://localhost:11434 por defecto)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODELO=

# Opcional: base de datos PostgreSQL en la nube (Neon, Supabase, Railway…)
# Si no se define, todo se guarda en SQLite local.
# DATABASE_URL=postgresql://usuario:clave@host.neon.tech:5432/sazonlab?sslmode=require
# DATABASE_SSL=true

# Opcional: administrador de demostración
# ADMIN_CORREO=admin@sazonlab.test
# ADMIN_PASSWORD=admin1234
