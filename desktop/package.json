{
  "name": "sazonlab-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "SazónLab — aplicación de escritorio (.exe)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^44.10.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.sazonlab.recetario",
    "productName": "SazonLab",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SazonLab"
    }
  }
}
