# Puerto del servidor API
PORT=3001

# Secreto para firmar JWT (¡cambiar en producción!)
JWT_SECRET=cambiar-en-produccion

# Opcional: API keys de IA (si no existen, se usa TheMealDB como fallback)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Opcional: base de datos PostgreSQL para despliegue web
# (si no está definida, se usa SQLite local)
DATABASE_URL=
